{
  "name": "postgres-query-box",
  "version": "0.1.1",
  "description": "A React query box for API transaction logs: field and value suggestions, inline errors with fixes, an Advanced filter builder and saved queries.",
  "license": "MIT",
  "author": "Darshan R",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darshanraj046/postgres-query-box.git"
  },
  "homepage": "https://github.com/darshanraj046/postgres-query-box#readme",
  "bugs": {
    "url": "https://github.com/darshanraj046/postgres-query-box/issues"
  },
  "keywords": [
    "postgres",
    "react",
    "query-builder",
    "search-box",
    "api-logs",
    "filter"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "css": "node scripts/gen-css.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --types react types/core.d.ts types/index.d.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "node -e \"if (!process.env.GITHUB_ACTIONS) { console.error('Publish by creating a GitHub release. The Publish workflow adds npm provenance.'); process.exit(1) }\" && npm run check"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
